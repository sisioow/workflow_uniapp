# 推荐：在仓库根目录编辑 local_config.yaml（从 local_config.example.yaml 复制）
# 本 .env 仍可作为兜底；若同时存在 local_config.yaml，以 local_config.yaml 为准。

# ── LLM（OpenAI 兼容）──
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.ali.cdn.pianke.xyz/v1
LLM_API_KEY=your-api-key
LLM_MODEL=deepseek/deepseek-v4-flash

# ── Google Stitch MCP ──
STITCH_API_KEY=your-stitch-api-key
STITCH_MCP_URL=https://stitch.googleapis.com/mcp

# ── 项目路径 ──
UNIAPP_TEMPLATE_DIR=/path/to/uniapp_base
UNIAPP_OUTPUT_DIR=/path/to/output

# ── 代码生成 CLI（可选）──
CODEX_BIN=codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CLAUDE_BIN=claude
CLAUDE_MODEL=
CURSOR_BIN=agent
CURSOR_MODEL=

# ── Web 服务 ──
HOST=0.0.0.0
PORT=8765
